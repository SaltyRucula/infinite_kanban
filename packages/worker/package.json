{
  "name": "@ai-agent-board/worker",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agentboard-worker": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts run",
    "build": "tsc -b tsconfig.build.json && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "test:package": "node --import tsx/esm --test tests/package-contract.pack.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@codewithdan/agent-sdk-core": "^0.7.0",
    "@openai/codex-sdk": "^0.139.0",
    "@opencode-ai/sdk": "^1.17.7",
    "express": "^4.22.2",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "~5.7.0"
  }
}
