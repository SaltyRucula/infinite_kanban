# syntax=docker/dockerfile:1
# AI Agent Board — worker image.
# Bundles the CLI worker (packages/worker) plus the `opencode` CLI it shells
# out to for the opencode-server runner. Registration (against a running
# board server) and the ~/.agentboard-worker/workspace.json runner override
# happen at container start via docker-entrypoint.sh, driven by env vars —
# see deploy/.env.example.worker for the full list.
FROM node:22-bookworm-slim AS build

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    HUSKY=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Manifests first for cacheable dependency install (npm workspaces need every
# workspace package.json present for `npm ci`).
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY packages/server/package.json ./packages/server/
COPY packages/client/package.json ./packages/client/
COPY packages/e2e/package.json ./packages/e2e/
COPY packages/worker/package.json ./packages/worker/

RUN npm ci --include=dev --no-audit --no-fund

COPY . .

# Build shared types then the worker (tsc -> dist/).
RUN npm run build:shared && npm run worker:build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# git: the worker performs git operations against cloned task repos.
# ca-certificates: TLS to the board server / git remotes.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# opencode CLI — the opencode-server runner spawns `opencode serve` on PATH.
RUN npm install -g opencode-ai && opencode --version

WORKDIR /app

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/shared ./shared
COPY --from=build /app/packages/worker ./packages/worker

COPY deploy/docker-entrypoint.worker.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# ~/.agentboard-worker holds registration credentials + workspace.json; mount
# a volume here so a container restart doesn't need to re-register.
ENV HOME=/home/worker
RUN useradd --create-home --home-dir /home/worker --shell /bin/bash worker \
    && mkdir -p /home/worker/.agentboard-worker /workspace \
    && chown -R worker:worker /home/worker /workspace /app
USER worker

# Host repos to work on — bind-mount your workspace parent dir here.
VOLUME ["/workspace", "/home/worker/.agentboard-worker"]

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "packages/worker/dist/cli.js", "run"]
