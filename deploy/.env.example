# Example deploy env — copy to deploy/.env and fill in a real password.
#   cp deploy/.env.example deploy/.env
# POSTGRES_PASSWORD must be URL-safe (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me-url-safe
# Server-side Host allowlist for WebSocket upgrades (add the host's IP/DNS).
ALLOWED_HOSTS=localhost,127.0.0.1,10.190.52.128
# CORS + WebSocket Origin allowlist.
ALLOWED_ORIGINS=http://localhost:8081,http://10.190.52.128

# ── Optional: worker (docker compose --profile worker up worker) ───────────
# Board server this worker registers against (the running `server` service,
# or a remote board URL).
AGENTBOARD_SERVER_URL=http://10.190.52.128
# workers:register scoped bootstrap token (see SERVICE_TOKENS above).
AGENTBOARD_TOKEN=change-me-registration-token
# Optional; defaults to the container hostname.
AGENTBOARD_WORKER_NAME=my-worker
# Comma-separated; only "opencode" is currently supported.
AGENTBOARD_AGENT_TYPES=opencode
# opencode agent used for tasks (workspace.json runner.agent).
RUNNER_AGENT=build
# Optional; forwarded to the worker CLI process, unset uses opencode's default model.
OPENCODE_WORKER_MODEL=
# Host directory containing the repos the worker should operate on
# (bind-mounted read-write to /workspace in the container).
WORKER_HOST_WORKSPACE=/home/you/Development
